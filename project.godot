; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Candela 2D"
config/version="0.4.2"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
; 2 = « Keep Width » : l'image d'amorce est mise à l'échelle sur la largeur de la
; fenêtre (RenderingServerTypes::SPLASH_STRETCH_MODE_KEEP_WIDTH).
; Le mode 1 (« Keep ») de Godot présente le comportement de caler la hauteur de l'image
; sur la hauteur de la fenêtre en mode paysage, ce qui faisait déborder l'enseigne
; sur les côtés gauche et droit (notamment sur écran 16:10 ou formats larges).
; Avec le mode 2 et une toile 16:9 (1920×1080) où le wordmark occupe 44 % de la largeur
; (règle PART_ENSEIGNE de DA6.5), l'amorce ne déborde jamais et s'aligne exactement
; sur la transition avec la séquence PowerOn.
boot_splash/stretch_mode=2
boot_splash/image="res://assets/logos/boot.png"
; 2026-09-10 — les deux faisceaux croisés, choisis par Adrien parmi trois
; propositions : le triangle de DA7 (`icone_roman.png`) faisait daté. Le PNG
; porte déjà son carré arrondi et sa marge (grille macOS, 824 px sur 1024) :
; Godot le convertit en .icns sans rien masquer. Les anciennes restent dans le
; dépôt.
config/icon="res://assets/logos/icone_faisceaux.png"

[audio]

buses/default_bus_layout="uid://c66ft6i7qo6dq"
bus_layout="res://default_bus_layout.tres"

[autoload]

PatchLoader="*res://patch_loader.gd"
ReplaySystem="*res://replay_system.gd"
InputSetup="*res://input_setup.gd"
AudioManager="*res://audio_manager.gd"
MapData="*res://map_data.gd"
NetworkManager="*res://network_manager.gd"
GameSettings="*res://settings_manager.gd"
UpdateManager="*res://update_manager.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
EOSGRuntime="*uid://7saywdx0ipep"
HPlatform="*uid://yl2muvqrdiud"
HAuth="*uid://786t1jiowvvg"
HAchievements="*uid://bis404dty5u5c"
HFriends="*uid://uumqbey8ji5t"
HStats="*uid://dbckdip83oone"
HLeaderboards="*uid://b06khhf20mplm"
HLobbies="*uid://6iqvm33q0tb1"
HP2P="*uid://u6ae5fpm6l8q"
HSessions="*uid://bieh2rxxahuu2"
RankedIdentity="*res://ranked_identity.gd"
Matchmaker="*res://matchmaking.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/epic-online-services-godot/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/Oxanium.ttf"

