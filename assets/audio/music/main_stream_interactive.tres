[gd_resource type="AudioStreamInteractive" load_steps=9 format=4 uid="uid://cw5mcdb0l0nn3"]

; Le système musical du jeu, en une ressource.
;
; Horizontal — quatre clips enchaînés par AudioManager.play_music() :
; intro → menu (enchaînement automatique), menu ↔ match, match → victory.
; Vertical — le clip « match » est un AudioStreamSynchronized de quatre
; couches à 170 BPM ; set_music_intensity() ouvre base → batterie → arpège, et
; update_low_health() la quatrième, le pouls.
;
; Les flux sont RÉFÉRENCÉS, plus embarqués. La version précédente recopiait les
; paquets Ogg dans ce fichier (700 ko de base64), ce qui la figeait : remplacer
; un stem obligeait à tout régénérer, et rien ne disait que le .ogg voisin
; n'était plus celui qu'on entendait.

[ext_resource type="AudioStream" uid="uid://wno8qnb8lriu" path="res://assets/audio/music/music_intro.ogg" id="1_intro"]
