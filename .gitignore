# Godot 4+ specific ignores
.godot/
/android/

# Identifiants Epic Online Services : jamais versionnés.
# Le modèle à recopier est eos_credentials.example.gd.
/eos_credentials.gd
/eos_credentials.gd.uid

# Binaires mobiles du plugin EOS : 246 Mo pour des plateformes que le jeu ne
# vise pas. Les retirer d'ici suffira à les versionner le jour d'un portage.
/addons/epic-online-services-godot/bin/ios/
/addons/epic-online-services-godot/bin/android/

# Exports locaux : lourds, reconstructibles, jamais versionnés.
/build/

# Configuration Supabase : la clé publiable n'est sûre qu'une fois la Row Level
# Security en place. Elle reste hors de git jusque-là.
# Le modèle à recopier est supabase_config.example.gd.
/supabase_config.gd
/supabase_config.gd.uid

# État local de la CLI Supabase : référence du projet lié, versions du serveur
# distant. Propre à une machine, recréé par `supabase link`.
/supabase/.temp/

# Worktrees des sous-agents : arbres de travail temporaires, jamais versionnés.
/.claude/worktrees/

# Analyses d'Ableton Live, posées à côté de chaque .wav qu'Adrien ouvre dans son
# DAW. Elles sont RECRÉÉES à l'ouverture et changent sans que le son change :
# les versionner ferait apparaître une modification à chaque écoute, pour zéro
# information. Repéré le 2026-09-03, quand un garde a compté 119 fichiers hors
# du dépôt dont une bonne part n'étaient que ces analyses — le nombre alarmait,
# la cause était bénigne.
*.asd
.DS_Store
