 ## pâte : une plaque un peu plus claire, et la couleur du joueur — ici portée par
 ## la lumière du bloc plutôt que par une bordure.
+## RETOUCHE DE MESURE (audit M, garde_theme ; V2 B1 / HUD-02) : lecture avant écriture. Une surcharge de thème écrite avec la valeur
+## qu'elle porte déjà notifie quand même le nœud (refaçonnage, tri différé du conteneur) : on ne l'écrit que si elle change.
+func _couleur_si_change(c: Control, nom: StringName, v: Color) -> void:
+	if c.has_theme_color_override(nom) and c.get_theme_color(nom) == v:
+		return
+	c.add_theme_color_override(nom, v)
+
+
+func _style_si_change(c: Control, nom: StringName, s: StyleBox) -> void:
+	if c.has_theme_stylebox_override(nom) and c.get_theme_stylebox(nom) == s:
+		return
+	c.add_theme_stylebox_override(nom, s)
+
+
 func _plaques_de_cartouche(panel: PanelContainer, active: bool, player_color: Color) -> StyleBox:
 	if panel.get_meta("bloc_teinte", Color.TRANSPARENT) != player_color:
