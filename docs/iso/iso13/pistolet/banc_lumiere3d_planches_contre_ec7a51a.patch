+func _la_planche_pistolet(carte: String, depart: Vector2, dir: Vector2) -> void:
+	var t := MursBas.TUILE
+	if dir == Vector2.ZERO:
+		print("BANC_LUMIERE3D cadrage_ignore carte=%s id=planche_pistolet raison=aucune_direction" % carte)
+		return
+	for avance in [3.0, 2.5, 3.5, 2.0]:
+		var p2: Vector2 = depart + dir * avance * t
+		if not _libre(p2, MursBas.RAYON_ENCOMBREMENT) or _mur_entre(depart, p2):
+			continue
+		var ancres := {"j1": [depart, HAUTEUR_CORPS], "j2": [p2, HAUTEUR_CORPS]}
+		print("BANC_LUMIERE3D planche_pistolet avance=%.1f" % avance)
+		_placer(depart, dir, true, p2, -dir, false)
+		await _serie_tenues("pistolet", ancres, TENUES_PISTOLET)
